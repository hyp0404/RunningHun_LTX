RUNNINGHUB_UPLOAD_PATH=/openapi/v2/media/upload/binary

QWEN_TTS_WEBAPP_ID=2051851200194195458
LTX23_WEBAPP_ID=2048763193677324290

RUNNINGHUB_AUTO_DISCOVER_NODES=true
QWEN_TTS_NODE_MAP_JSON=
