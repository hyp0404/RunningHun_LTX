RUNNINGHUB_API_KEY=替换成你的RunningHub_API_Key
RUNNINGHUB_WEBAPP_ID=2048763193677324290
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_AUTO_DISCOVER_NODES=true
RUNNINGHUB_HTTP_TIMEOUT_SECONDS=120
RUNNINGHUB_POLL_INTERVAL_SECONDS=5
RUNNINGHUB_UPLOAD_PATH=/openapi/v2/media/upload/binary
MAX_REMOTE_FILE_BYTES=209715200
# Railway 正式部署请替换为 /mcp/加至少32位随机字符串
MCP_PATH=/mcp
LOG_LEVEL=INFO

# 如果应用页面显示访问加密，再填写：
# RUNNINGHUB_ACCESS_PASSWORD=

# 自动识别不准确时，根据 inspect_ltx23_app 的 available_nodes 填写：
# RUNNINGHUB_NODE_MAP_JSON={"image":"节点ID:字段名","audio":"节点ID:字段名","prompt":"节点ID:字段名"}

# 如需固定某个额外节点，可填写：
# RUNNINGHUB_EXTRA_NODE_INFO_JSON=[{"nodeId":"123","fieldName":"value","fieldValue":1}]
